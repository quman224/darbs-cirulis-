$servisi = Get-Service

$darbojas = 0
$aptureti = 0

foreach ($serviss in $servisi) {
    if ($serviss.Status -eq "Running") {
        $darbojas++
    }
    elseif ($serviss.Status -eq "Stopped") {
        $aptureti++
    }
}

Write-Output "Darbojas: $darbojas"
Write-Output "Aptureti: $aptureti"
Write-Output "Kopa: $($darbojas + $aptureti)"
