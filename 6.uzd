Get-CimInstance Win32_LogicalDisk -Filter "DriveType=3" | ForEach-Object { $briva=[math]::Round($_.FreeSpace/1GB,1); Write-Output "$($_.DeviceID) Kopā: $([math]::Round($_.Size/1GB,1)) GB; Brīvs: $briva GB"; if ($briva -lt 10) { Write-Output "BRĪDINĀJUMS: Maz brīvas vietas!" } }

C: Kopā: 380 GB; Brīvs: 292 GB
