$procesi = Get-Process

$rezultats = $procesi | Sort-Object -Property WorkingSet64 | Select-Object -Last 10 | Select-Object @{Name="Nosaukums"; Expression={$_.ProcessName}}, @{Name="ID"; Expression={$_.Id}}, @{Name="Atmina_MB"; Expression={[math]::Round($_.WorkingSet64 / 1MB, 1)}}

$rezultats | Format-Table -AutoSize
